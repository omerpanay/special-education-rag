# ============================================================
# EduRAG Backend — Ortam Değişkenleri Şablonu
# ============================================================
# Kullanım: cp .env.example .env
# Ardından .env içindeki değerleri kendi bilgilerinizle doldurun.
# .env asla git'e commit edilmez (.gitignore'da tanımlı).
# ============================================================

# ── Veritabanı ───────────────────────────────────────────────
# Local dev (docker compose): db hostname → docker-compose.yml'deki servis adı
# Production (Render): Render Dashboard'dan otomatik enjekte edilir
DATABASE_URL=postgresql+asyncpg://edurag:edurag123@localhost:5433/edurag_db

# Docker Compose için ayrı DB bilgileri (docker-compose.yml okur)
POSTGRES_USER=edurag
POSTGRES_PASSWORD=edurag123
POSTGRES_DB=edurag_db

# ── Güvenlik ─────────────────────────────────────────────────
# JWT imzalama anahtarı — üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production'da mutlaka değiştir, min 32 karakter
SECRET_KEY=change-me-to-a-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM — Groq API ───────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3-turbo

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── RAG Ayarları ─────────────────────────────────────────────
# Zero-Hallucination eşiği (Constitution İlkesi I)
COSINE_THRESHOLD=0.70

# ── Agentic RAG — Tavily Web Search ──────────────────────────
# https://app.tavily.com/home
TAVILY_API_KEY=tvly-your_tavily_api_key_here
WEB_SEARCH_ENABLED=true

# ── HuggingFace — Materyal Görseli Üretimi ───────────────────
# https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here

# ── LangSmith — AI Pipeline Tracing ──────────────────────────
# https://smith.langchain.com → Settings → API Keys
# Tüm LangChain/LangGraph chain'leri otomatik izlenir (0 kod değişikliği)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_api_key_here
LANGCHAIN_PROJECT=edurag-production

# ── Uygulama ─────────────────────────────────────────────────
APP_NAME=EduRAG
# Production'da mutlaka false yap!
DEBUG=false
