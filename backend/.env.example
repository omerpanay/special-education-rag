# ============================================
# EduRAG Backend — Ortam Değişkenleri
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# --- Veritabanı ---
# Format: postgresql+asyncpg://kullanıcı:şifre@host:port/veritabanı
DATABASE_URL=postgresql+asyncpg://postgres:sifrem123@localhost:5433/edurag

# --- LLM (Groq API) ---
# Groq Console'dan alınır: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Güvenlik ---
# JWT token imzalama anahtarı (rastgele string):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# --- Model Konfigürasyonu ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=llama-3.3-70b-versatile

# --- RAG Ayarları ---
# Constitution ilkesi I: Zero-Hallucination eşiği
COSINE_THRESHOLD=0.70

# --- JWT Ayarları ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
